{
  "name": "@foglamp/design-system",
  "version": "0.1.0",
  "description": "Foglamp Design System, extracted AS-IS from foglamp-labs/foglamp by Gustavo Fior and Foglamp Labs, co-founded by Abdul Haidar.",
  "homepage": "https://github.com/foglamp-labs/foglamp",
  "author": "Gustavo Fior / Foglamp Labs; Abdul Haidar",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    "./assets/*": "./src/assets/*",
    "./ui/button-styles": "./src/ui/button-styles.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./icons/*": "./src/icons/*.tsx",
    "./widgets/leaf/preset-meta": "./src/widgets/leaf/preset-meta.ts",
    "./widgets/leaf/favicon": "./src/widgets/leaf/favicon.ts",
    "./widgets/leaf/*": "./src/widgets/leaf/*.tsx",
    "./widgets/*": "./src/widgets/*.tsx",
    "./blocks/*": "./src/blocks/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/link-context": "./src/lib/link-context.tsx",
    "./lib/prompts": "./src/lib/prompts/index.ts",
    "./lib/prompts/*": "./src/lib/prompts/*.ts",
    "./lib/scan/*": "./src/lib/scan/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles/*": "./src/styles/*.css"
  },
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@tabler/icons-react": "^3.41.1",
    "@toolwind/corner-shape": "^0.0.8-3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.4",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "elkjs": "^0.11.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.3",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
